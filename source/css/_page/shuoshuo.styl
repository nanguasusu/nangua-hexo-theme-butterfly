#body-wrap.type-shuoshuo
  --shuoshuo-primary: #7187a8
  --shuoshuo-primary-soft: #edf2f8
  --shuoshuo-text: #40454f
  --shuoshuo-muted: #9aa0aa

  .layout
    max-width: 720px !important
    width: 100% !important
    margin: 20px auto 40px !important
    padding: 0 16px !important

    > #page
      width: 100% !important
      padding: 0 !important
      background: transparent !important
      border: none !important
      box-shadow: none !important

    > #page.nc
      background: transparent !important
      box-shadow: none !important

  #aside-content
    display: none !important

  .page-title
    display: none !important

  #page-header.nav-fixed #nav,
  #page-header.not-top-img #nav
    background: rgba(255, 255, 255, .86)
    border-bottom: 1px solid rgba(0, 0, 0, .05)
    box-shadow: 0 2px 12px rgba(0, 0, 0, .04)
    backdrop-filter: blur(16px)
    -webkit-backdrop-filter: blur(16px)

/* 朋友圈主体外壳 */
.shuoshuo-moments-wrap
  background: transparent

/* 朋友圈顶部封面 */
.moments-header
  margin-bottom: 22px

  .moments-cover
    position: relative
    width: 100%
    height: 220px
    overflow: visible
    border-radius: 16px
    background-size: cover
    background-position: center

    +maxWidth768()
      height: 168px

  .moments-cover-mask
    position: absolute
    top: 0
    right: 0
    bottom: 0
    left: 0
    border-radius: inherit
    background: linear-gradient(to bottom, rgba(0, 0, 0, .05) 20%, rgba(0, 0, 0, .38) 100%)

  .moments-user-row
    position: absolute
    right: 22px
    bottom: -46px
    z-index: 2
    display: flex
    align-items: flex-end
    gap: 12px

  .moments-username
    margin-bottom: 52px
    color: #fff
    font-weight: 600
    font-size: 1.05rem
    text-shadow: 0 1px 8px rgba(0, 0, 0, .45)
    letter-spacing: .3px

  .moments-avatar-box
    width: 72px
    height: 72px
    overflow: hidden
    border: 2px solid #fff
    border-radius: 12px
    background: #fff
    box-shadow: 0 6px 18px rgba(0, 0, 0, .12)

    +maxWidth768()
      width: 64px
      height: 64px

    img
      display: block !important
      width: 100% !important
      height: 100% !important
      max-width: 100% !important
      margin: 0 !important
      border-radius: 0 !important
      object-fit: cover !important

  .moments-signature
    padding: 58px 8px 6px
    color: var(--shuoshuo-muted)
    text-align: right
    font-size: 12px
    letter-spacing: .2px

    +maxWidth768()
      padding: 52px 4px 4px

/* 说说列表 */
#article-container
  padding: 0 !important
  margin: 0 !important

  .moments-list
    display: flex
    flex-direction: column
    gap: 12px
    width: 100%

  .moments-item
    display: flex
    gap: 12px
    padding: 16px 18px
    border-radius: 14px
    background: rgba(255, 255, 255, .82)
    box-shadow: 0 4px 24px rgba(0, 0, 0, .035)

    +maxWidth768()
      gap: 10px
      padding: 14px 14px

  .moments-item-avatar
    width: 40px !important
    height: 40px !important
    min-width: 40px !important
    max-width: 40px !important
    overflow: hidden
    flex-shrink: 0
    border-radius: 8px

    +maxWidth768()
      width: 36px !important
      height: 36px !important
      min-width: 36px !important
      max-width: 36px !important

    img
      display: block !important
      width: 40px !important
      height: 40px !important
      max-width: 40px !important
      max-height: 40px !important
      margin: 0 !important
      border-radius: 0 !important
      object-fit: cover !important

      +maxWidth768()
        width: 36px !important
        height: 36px !important
        max-width: 36px !important
        max-height: 36px !important

  .moments-item-main
    min-width: 0
    max-width: 600px
    flex: 1

  .moments-item-author
    margin-bottom: 6px
    color: var(--shuoshuo-primary)
    font-weight: 600
    font-size: .92rem
    line-height: 1.3

  .moments-line-icon
    display: block
    width: 13px
    height: 13px
    flex-shrink: 0
    fill: none
    stroke: currentColor
    stroke-width: 1.6
    stroke-linecap: round
    stroke-linejoin: round

  .moments-text
    margin-bottom: 4px
    color: var(--shuoshuo-text)
    word-break: break-word
    font-size: .94rem
    line-height: 1.7

    &.can-fold
      transition: max-height .28s ease

    &.is-collapsed
      overflow: hidden

    & > *:last-child
      margin-bottom: 0 !important

    p
      margin: 0 0 6px !important

      &:last-child
        margin-bottom: 0 !important

    a
      color: var(--shuoshuo-primary)
      text-decoration: none

      &:hover
        text-decoration: underline

  .moments-fold
    display: inline-flex
    align-items: center
    gap: 2px
    margin: 0 0 6px
    padding: 0
    border: 0
    background: none
    color: var(--shuoshuo-primary)
    opacity: .72
    font-size: 13px
    line-height: 1.4
    cursor: pointer

    .moments-fold-chevron
      width: 12px
      height: 12px
      transition: transform .2s ease

    &.is-open .moments-fold-chevron
      transform: rotate(180deg)

    &:hover
      opacity: 1

  /* 朋友圈九宫格 */
  .moments-photos
    display: grid
    gap: 8px
    width: max-content
    max-width: 100%
    margin: 10px 0 8px

    .moments-photo-item
      position: relative
      display: block
      overflow: hidden
      padding: 0
      width: 100%
      border: 0
      border-radius: 10px
      background: var(--shuoshuo-primary-soft)
      aspect-ratio: 1
      line-height: 0
      cursor: zoom-in

      &:hover
        text-decoration: none

      img
        display: block !important
        margin: 0 !important
        width: 100% !important
        height: 100% !important
        max-width: 100% !important
        border-radius: 0 !important
        object-fit: cover !important
        transition: transform .3s ease

      &:hover img
        transform: scale(1.04)

    &.count-1
      width: max-content
      max-width: 100%

      .moments-photo-item
        width: auto
        height: auto
        aspect-ratio: auto

        img
          width: auto !important
          height: auto !important
          max-width: 420px
          max-height: 460px
          object-fit: contain !important

        &:hover img
          transform: none

        &.is-landscape img
          max-width: 520px
          max-height: 420px

        &.is-portrait img
          max-width: 320px
          max-height: 500px

    &.count-2,
    &.count-4
      grid-template-columns: repeat(2, 112px)

    &.count-3,
    &.count-5,
    &.count-6,
    &.count-7,
    &.count-8,
    &.count-9
      grid-template-columns: repeat(3, 112px)

    +maxWidth768()
      width: 100%
      max-width: 100%

      &.count-1
        width: 100%

        .moments-photo-item
          max-width: 100%

          img
            max-width: 100% !important
            max-height: 70vh !important

      &.count-2,
      &.count-4
        grid-template-columns: repeat(2, minmax(0, 1fr))
        max-width: 248px

      &.count-3,
      &.count-5,
      &.count-6,
      &.count-7,
      &.count-8,
      &.count-9
        grid-template-columns: repeat(3, minmax(0, 1fr))
        max-width: 360px

  .moments-tags
    display: flex
    flex-wrap: wrap
    gap: 6px
    margin: 6px 0

  .moments-tag
    color: var(--shuoshuo-primary)
    font-size: .8rem
    cursor: default

  .moments-item-footer
    display: flex
    justify-content: space-between
    align-items: center
    gap: 12px
    margin-top: 12px

  .moments-meta-info
    display: flex
    flex-wrap: wrap
    align-items: center
    gap: 12px
    color: #9ca3af
    font-size: 12.5px
    line-height: 1.4

  .moments-pin
    color: var(--shuoshuo-primary)
    font-weight: 500

  .moments-tail
    display: inline-flex
    align-items: center
    gap: 4px
    color: #9ca3af

  .moments-actions
    display: flex
    align-items: center
    flex-shrink: 0

  .moments-action-btn
    display: inline-flex
    align-items: center
    justify-content: center
    width: 28px
    height: 28px
    padding: 0
    border: 0
    border-radius: 8px
    background: transparent
    color: var(--shuoshuo-muted)
    line-height: 1
    cursor: pointer
    transition: background .2s ease, color .2s ease

    &:hover
      background: var(--shuoshuo-primary-soft)
      color: var(--shuoshuo-primary)

  /* 朋友圈气泡式互动区 */
  .moments-interactive-box
    position: relative
    display: none
    margin-top: 10px
    border-radius: 10px
    background: var(--shuoshuo-primary-soft)

    &.has-content
      display: block

    &::before
      position: absolute
      top: -5px
      right: 22px
      width: 0
      height: 0
      border-right: 5px solid transparent
      border-bottom: 5px solid var(--shuoshuo-primary-soft)
      border-left: 5px solid transparent
      content: ''

  .moments-comment-list
    padding: 8px 12px
    color: var(--shuoshuo-text)
    font-size: 14px
    line-height: 1.55

    &[hidden]
      display: none

  .moments-comment-line
    display: -webkit-box
    margin: 0
    overflow: hidden
    -webkit-box-orient: vertical
    -webkit-line-clamp: 4
    word-break: break-word

    & + &
      margin-top: 6px

  .moments-comment-name
    color: var(--shuoshuo-primary)
    font-weight: 600

  .moments-comment-box
    margin-top: 10px

    &.no-comment
      display: none
      margin-top: 0

    .custom-hr,
    .comment-head
      display: none

    #post-comment,
    .comment-wrap
      margin: 0
      padding: 0
      background: transparent
      box-shadow: none

  .moments-loading,
  .moments-empty,
  .moments-error
    display: flex
    flex-direction: column
    justify-content: center
    align-items: center
    gap: 12px
    padding: 60px 20px
    color: var(--shuoshuo-muted)
    font-size: .95rem

    i
      color: var(--shuoshuo-primary)
      font-size: 2rem

/* 分页 */
.shuoshuo-navigation
  display: flex
  justify-content: center
  align-items: center
  gap: 8px
  margin-top: 24px
  padding: 16px 0

  button
    display: flex
    justify-content: center
    align-items: center
    width: 2.6em
    height: 2.6em
    border: 1px solid rgba(0, 0, 0, .06)
    border-radius: 8px
    background: var(--card-bg, #fff)
    color: var(--font-color, #555)
    font-size: .9em
    cursor: pointer
    transition: all .2s ease-in-out

    &:not(:disabled):hover
      border-color: #576b95
      background-color: #576b95
      color: #fff

    &:disabled
      background: rgba(0, 0, 0, .03)
      color: #bbb
      opacity: .6
      cursor: not-allowed

  .shuoshuo-page-info
    margin: 0 10px
    color: #888
    white-space: nowrap
    font-size: .88em

  .shuoshuo-page-input
    height: 2.6em
    padding: 0 10px
    border: 1px solid rgba(0, 0, 0, .08)
    border-radius: 8px
    background: var(--card-bg, #fff)
    color: #666
    text-align: center
    font-size: .9em
    transition: all .2s ease-in-out

    &:focus
      border-color: #576b95
      outline: none

    &::-webkit-outer-spin-button,
    &::-webkit-inner-spin-button
      margin: 0
      -webkit-appearance: none

    -moz-appearance: textfield

/* 全屏大图预览 */
.moments-preview
  position: fixed
  top: 0
  right: 0
  bottom: 0
  left: 0
  z-index: 9999
  display: flex
  justify-content: center
  align-items: center
  background: rgba(0, 0, 0, .88)
  backdrop-filter: blur(20px)
  -webkit-backdrop-filter: blur(20px)
  touch-action: pan-y

  &[hidden]
    display: none

  .moments-preview-image
    width: auto !important
    height: auto !important
    max-width: 90vw !important
    max-height: 84vh !important
    margin: 0 !important
    border-radius: 6px !important
    box-shadow: 0 8px 32px rgba(0, 0, 0, .6)
    object-fit: contain !important
    cursor: default

  .moments-preview-loading
    position: absolute
    top: 50%
    left: 50%
    display: none
    width: 40px
    height: 40px
    margin: -20px 0 0 -20px
    border: 3px solid rgba(255, 255, 255, .25)
    border-top-color: #576b95
    border-radius: 50%
    pointer-events: none
    animation: moments-preview-spin .7s linear infinite

  &.is-loading
    .moments-preview-loading
      display: block

    .moments-preview-image
      opacity: 0

  button
    position: absolute
    display: flex
    justify-content: center
    align-items: center
    border: 1px solid rgba(255, 255, 255, .15)
    border-radius: 50%
    background: rgba(0, 0, 0, .45)
    color: #fff
    cursor: pointer
    transition: background .2s ease, transform .2s ease

    &:hover
      background: var(--shuoshuo-primary)
      transform: scale(1.08)

  .moments-preview-close
    top: 20px
    right: 20px
    width: 42px
    height: 42px
    font-size: 20px

  .moments-preview-prev,
  .moments-preview-next
    top: 50%
    width: 48px
    height: 48px
    font-size: 20px
    transform: translateY(-50%)

    &:hover
      transform: translateY(-50%) scale(1.08)

  .moments-preview-prev
    left: 20px

  .moments-preview-next
    right: 20px

  .moments-preview-count
    position: absolute
    bottom: 24px
    left: 50%
    padding: 4px 14px
    border-radius: 16px
    background: rgba(0, 0, 0, .5)
    color: #fff
    font-size: 13px
    transform: translateX(-50%)
    backdrop-filter: blur(8px)

  &.is-single
    .moments-preview-prev,
    .moments-preview-next,
    .moments-preview-count
      display: none

body.moments-preview-open
  overflow: hidden

@keyframes moments-preview-spin
  to
    transform: rotate(360deg)

/* 暗色模式适配 */
[data-theme="dark"]
  #body-wrap.type-shuoshuo
    --shuoshuo-primary: #8ea4c4
    --shuoshuo-primary-soft: rgba(113, 135, 168, .16)
    --shuoshuo-text: #d5d8de
    --shuoshuo-muted: #8b93a0

    #page-header.nav-fixed #nav,
    #page-header.not-top-img #nav
      background: rgba(18, 20, 23, .86)
      border-bottom: 1px solid rgba(255, 255, 255, .08)
      box-shadow: 0 2px 12px rgba(0, 0, 0, .4)

    .moments-avatar-box
      border-color: #1a1d23
      background: #1a1d23

  #article-container
    .moments-item
      background: rgba(32, 36, 44, .78)
      box-shadow: 0 4px 24px rgba(0, 0, 0, .22)

    .moments-loading,
    .moments-empty,
    .moments-error
      color: var(--shuoshuo-muted)

      i
        color: var(--shuoshuo-primary)

  .shuoshuo-navigation
    button
      border-color: rgba(255, 255, 255, .08)
      background: rgba(26, 29, 35, .88)
      color: #aaa

      &:disabled
        background: rgba(255, 255, 255, .02)
        color: #555

    .shuoshuo-page-input
      border-color: rgba(255, 255, 255, .08)
      background: rgba(26, 29, 35, .88)
      color: #aaa
