- page.toc = false

.shuoshuo-moments-wrap
  .moments-header
    .moments-cover(style=`background-image: url('${theme.default_top_img || theme.index_img || url_for(theme.avatar.img)}')`)
      .moments-cover-mask
      .moments-user-row
        span.moments-username= config.author || '楠瓜'
        .moments-avatar-box
          img.no-lightbox(src=url_for(theme.avatar.img) alt=config.author)
    .moments-signature
      span.signature-text= theme.aside && theme.aside.card_author && theme.aside.card_author.description || config.description || '自在摇曳，生生不息。'

  #shuoshuo-filters.moments-filters(hidden aria-label='筛选说说')
    .moments-filter-field
      button.moments-time-trigger(type='button' aria-expanded='false' aria-controls='moments-time-panel')
        svg(viewBox='0 0 24 24' aria-hidden='true')
          path(d='M8 3v4m8-4v4M4 10h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1z')
        span.moments-time-label 全部时间
        svg.moments-filter-chevron(viewBox='0 0 24 24' aria-hidden='true')
          path(d='m8 10 4 4 4-4')
      #moments-time-panel.moments-filter-panel(hidden role='dialog' aria-label='按时间筛选说说')
    .moments-filter-field
      button.moments-tag-trigger(type='button' aria-expanded='false' aria-controls='moments-tag-panel')
        span.moments-tag-label 全部标签
        svg.moments-filter-chevron(viewBox='0 0 24 24' aria-hidden='true')
          path(d='m8 10 4 4 4-4')
      #moments-tag-panel.moments-filter-panel.moments-tags-panel(hidden role='dialog' aria-label='按标签筛选说说')
    button.moments-filter-reset(type='button' hidden) 清除筛选
    span.moments-filter-count(role='status' aria-live='polite')

  #article-container
    //- Empty arrays are valid data sources too; the client renderer owns the empty state.
    if page.shuoshuo_url || site.data.shuoshuo
      if page.comments !== false && theme.comments.use
        - commentsJsLoad = true

        script.
          (() => {
            const commentDiv = `!{partial('includes/third-party/comments/index', {}, {cache: true})}`
            const commentRepo = !{JSON.stringify(theme.utterances && theme.utterances.repo || '')}
            const githubHeaders = { Accept: 'application/vnd.github+json' }
            let issueIndexTask = null

            const escapeHtml = str => String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;')
            const cssEscape = value => window.CSS && CSS.escape ? CSS.escape(value) : String(value).replace(/"/g, '\\"')
            const issueTerm = key => `${location.pathname.replace(/\/$/, '')}?key=${key}`

            const runDestroy = (shuoshuoComment) => {
              if (!shuoshuoComment) return

              for (const [key, fn] of Object.entries(shuoshuoComment)) {
                if (key.startsWith('destroy')) fn()
              }
            }

            const plainComment = body => String(body || '')
              .replace(/!\[[^\]]*]\([^)]*\)/g, '')
              .replace(/\[([^\]]*)]\([^)]*\)/g, '$1')
              .replace(/```[\s\S]*?```/g, ' ')
              .replace(/\s+/g, ' ')
              .trim()

            const loadIssueIndex = () => {
              if (issueIndexTask) return issueIndexTask
              issueIndexTask = (async () => {
                const index = new Map()
                if (!commentRepo) return index
                const phrase = `${location.pathname.replace(/\/$/, '')}?key=`
                const q = `repo:${commentRepo} is:issue "${phrase}" in:title`
                const response = await fetch(`https://api.github.com/search/issues?per_page=100&q=${encodeURIComponent(q)}`, { headers: githubHeaders })
                if (!response.ok) throw new Error(`GitHub search ${response.status}`)
                const data = await response.json()
                for (const issue of data.items || []) index.set(issue.title, issue)
                return index
              })().catch(error => {
                issueIndexTask = null
                throw error
              })
              return issueIndexTask
            }

            const renderCommentList = (item, comments) => {
              const bubble = item.querySelector('.moments-interactive-box')
              const list = item.querySelector('.moments-comment-list')
              if (!bubble || !list) return
              if (!comments.length) {
                list.replaceChildren()
                list.hidden = true
                bubble.classList.remove('has-content')
                return
              }
              list.innerHTML = comments.map(comment => `<p class="moments-comment-line"><span class="moments-comment-name">${escapeHtml(comment.user)}</span>：${escapeHtml(comment.text)}</p>`).join('')
              list.hidden = false
              bubble.classList.add('has-content')
            }

            const loadComments = async key => {
              const index = await loadIssueIndex()
              const issue = index.get(issueTerm(key))
              if (!issue || !issue.comments) return []
              const response = await fetch(`https://api.github.com/repos/${commentRepo}/issues/${issue.number}/comments?per_page=100`, { headers: githubHeaders })
              if (!response.ok) throw new Error(`GitHub comments ${response.status}`)
              const data = await response.json()
              return data.flatMap(comment => {
                const text = plainComment(comment.body)
                if (!text) return []
                return [{ user: comment.user && comment.user.login || '访客', text }]
              })
            }

            const paintComments = async (key, refresh = false) => {
              if (refresh) issueIndexTask = null
              const box = document.querySelector(`.moments-comment-box[data-key="${cssEscape(key)}"]`)
              const item = box && box.closest('.moments-item')
              if (!item) return
              try {
                const comments = await loadComments(key)
                if (item.isConnected) renderCommentList(item, comments)
              } catch (error) {
                console.error(error)
              }
            }

            window.refreshShuoshuoComment = key => paintComments(key, true)

            document.addEventListener('shuoshuo:rendered', () => {
              issueIndexTask = null
              document.querySelectorAll('.moments-comment-box[data-key]').forEach(box => {
                paintComments(box.getAttribute('data-key'))
              })
            })

            window.addCommentToShuoshuo = e => {
              const btn = e.target.closest('.moments-action-comment')
              if (!btn) return

              const item = btn.closest('.moments-item')
              if (!item) return
              const ele = item.querySelector('.moments-comment-box')
              if (!ele) return

              const { shuoshuoComment } = window
              const opening = ele.classList.contains('no-comment')
              const previous = document.querySelector('.moments-comment-box:not(.no-comment)')
              const previousKey = previous && previous.getAttribute('data-key')
              runDestroy(shuoshuoComment)
              document.querySelectorAll('.moments-action-comment[aria-expanded="true"]').forEach(button => {
                button.setAttribute('aria-expanded', 'false')
              })

              if (opening) {
                ele.classList.remove('no-comment')
                ele.innerHTML = commentDiv
                const key = issueTerm(ele.getAttribute('data-key'))
                btf.switchComments(ele, key)
                shuoshuoComment && shuoshuoComment.loadComment && shuoshuoComment.loadComment(ele, key)
                btn.setAttribute('aria-expanded', 'true')
                if (previousKey && previousKey !== ele.getAttribute('data-key')) {
                  window.refreshShuoshuoComment(previousKey)
                }
              } else {
                ele.classList.add('no-comment')
                ele.innerHTML = ''
                window.refreshShuoshuoComment(ele.getAttribute('data-key'))
              }
            }
          })()

      - const localDate = page.shuoshuo_url ? [] : shuoshuoFN(site.data.shuoshuo, page)

      if !page.shuoshuo_url
        script(type='application/json' id='shuoshuo-data')!= safeJSON(localDate)

      script.
        (() => {
          const limitConfig = !{ JSON.stringify(page.limit || {}) }

          const escapeHtml = str => String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;')

          const sortDataByDate = data => data.sort((a, b) => {
            const pin = Number(b.top === true) - Number(a.top === true)
            if (pin) return pin
            return new Date(b.date) - new Date(a.date)
          })

          const filterDataByLimit = (data, limit) => {
            if (!limit || !limit.type) return data
            if (limit.type === 'num') return data.slice(0, limit.value)
            if (limit.type === 'date') {
              const limitDate = new Date(limit.value)
              return data.filter(item => new Date(item.date) >= limitDate)
            }
            return data
          }

          const dateFormatter = new Intl.DateTimeFormat('en-GB', {
            timeZone: !{JSON.stringify(config.timezone || '')} || Intl.DateTimeFormat().resolvedOptions().timeZone,
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            hour12: false
          })

          const formatToTimeZone = (date) => {
            const fullDate = date.length === 10 ? `${date} 00:00:00` : date
            const [day, month, year, hour, minute, second] = dateFormatter.format(new Date(fullDate)).match(/\d+/g)
            return `${year}-${month}-${day} ${hour}:${minute}:${second}`
          }

          let currentPage = 1
          const itemsPerPage = 8
          let totalPages = 0
          let data = []
          let allData = []
          let selectedMonth = ''
          let selectedTag = ''
          const filterRoot = document.getElementById('shuoshuo-filters')
          const timeTrigger = filterRoot.querySelector('.moments-time-trigger')
          const tagTrigger = filterRoot.querySelector('.moments-tag-trigger')
          const timePanel = filterRoot.querySelector('#moments-time-panel')
          const tagPanel = filterRoot.querySelector('#moments-tag-panel')
          const resetFiltersButton = filterRoot.querySelector('.moments-filter-reset')
          const maxPhotos = 9
          let months = []
          let years = []
          let tags = []
          let archiveYear = ''
          let yearPage = 0
          let showingYears = false
          let openFilter = ''
          const yearsPerPage = 12

          const closeFilter = (restoreFocus = false) => {
            const trigger = openFilter === 'time' ? timeTrigger : tagTrigger
            openFilter = ''
            timePanel.hidden = true
            tagPanel.hidden = true
            timeTrigger.setAttribute('aria-expanded', 'false')
            tagTrigger.setAttribute('aria-expanded', 'false')
            if (restoreFocus) trigger.focus({ preventScroll: true })
          }

          const renderTimePanel = () => {
            const index = years.indexOf(archiveYear)
            const pageYears = years.slice(yearPage * yearsPerPage, (yearPage + 1) * yearsPerPage)
            const previousDisabled = showingYears ? yearPage === 0 : index === 0
            const nextDisabled = showingYears ? (yearPage + 1) * yearsPerPage >= years.length : index === years.length - 1
            const heading = showingYears ? `${pageYears.at(-1)} — ${pageYears[0]}` : `${archiveYear} 年`
            const choices = showingYears
              ? pageYears.map(year => `<button type="button" data-year="${year}" aria-pressed="${year === archiveYear}">${year}</button>`).join('')
              : Array.from({ length: 12 }, (_, index) => {
                const number = index + 1
                const month = `${archiveYear}-${String(number).padStart(2, '0')}`
                return `<button type="button" data-month="${month}" aria-pressed="${month === selectedMonth}"${months.includes(month) ? '' : ' disabled'}>${number} 月</button>`
              }).join('')
            timePanel.innerHTML = `<div class="moments-archive-heading"><button type="button" data-archive-step="-1" aria-label="${showingYears ? '较新的一组年份' : '较新年份'}"${previousDisabled ? ' disabled' : ''}>‹</button><button type="button" class="moments-archive-year" data-archive-years aria-label="${showingYears ? '返回月份' : '选择年份'}" aria-expanded="${showingYears}">${heading}<span aria-hidden="true">⌄</span></button><button type="button" data-archive-step="1" aria-label="${showingYears ? '较早的一组年份' : '较早年份'}"${nextDisabled ? ' disabled' : ''}>›</button></div><div class="moments-archive-grid" aria-label="${showingYears ? '年份' : '月份'}">${choices}</div><button type="button" class="moments-archive-all" data-month="" aria-pressed="${!selectedMonth}">全部时间</button>`
          }

          const renderTagPanel = () => {
            tagPanel.innerHTML = ['', ...tags].map(tag => `<button type="button" data-filter-tag="${escapeHtml(tag)}" aria-pressed="${tag === selectedTag}">${tag ? '#' + escapeHtml(tag) : '全部标签'}</button>`).join('')
          }

          const toggleFilter = name => {
            if (openFilter === name) {
              closeFilter()
              return
            }
            closeFilter()
            openFilter = name
            if (name === 'time') {
              archiveYear = selectedMonth ? selectedMonth.slice(0, 4) : years[0]
              yearPage = Math.floor(years.indexOf(archiveYear) / yearsPerPage)
              showingYears = false
              renderTimePanel()
            } else renderTagPanel()
            const panel = name === 'time' ? timePanel : tagPanel
            const trigger = name === 'time' ? timeTrigger : tagTrigger
            panel.hidden = false
            trigger.setAttribute('aria-expanded', 'true')
          }

          const setupFilters = () => {
            months = [...new Set(allData.map(item => item.month))].sort().reverse()
            years = [...new Set(months.map(month => month.slice(0, 4)))]
            tags = [...new Set(allData.flatMap(item => item.tags))].sort((left, right) => left.localeCompare(right, 'zh-CN'))
            tagTrigger.disabled = tags.length === 0
            filterRoot.hidden = allData.length === 0
          }

          const applyFilters = () => {
            data = allData.filter(item => (!selectedMonth || item.month === selectedMonth) && (!selectedTag || item.tags.includes(selectedTag)))
            currentPage = 1
            totalPages = Math.ceil(data.length / itemsPerPage)
            const [year, month] = selectedMonth.split('-')
            filterRoot.querySelector('.moments-time-label').textContent = selectedMonth ? `${year} 年 ${Number(month)} 月` : '全部时间'
            filterRoot.querySelector('.moments-tag-label').textContent = selectedTag ? `#${selectedTag}` : '全部标签'
            timeTrigger.classList.toggle('is-active', Boolean(selectedMonth))
            tagTrigger.classList.toggle('is-active', Boolean(selectedTag))
            resetFiltersButton.hidden = !selectedMonth && !selectedTag
            filterRoot.querySelector('.moments-filter-count').textContent = `共 ${data.length} 条`
            renderPage(currentPage)
          }

          const clearFilters = () => {
            closeFilter()
            selectedMonth = ''
            selectedTag = ''
            applyFilters()
          }

          timeTrigger.addEventListener('click', () => toggleFilter('time'))
          tagTrigger.addEventListener('click', () => toggleFilter('tags'))
          timePanel.addEventListener('click', event => {
            const button = event.target.closest('button')
            if (!button || button.disabled) return
            if (button.hasAttribute('data-month')) {
              selectedMonth = button.dataset.month
              closeFilter(true)
              applyFilters()
              return
            }
            if (button.hasAttribute('data-year')) {
              archiveYear = button.dataset.year
              showingYears = false
            } else if (button.hasAttribute('data-archive-years')) {
              showingYears = !showingYears
              yearPage = Math.floor(years.indexOf(archiveYear) / yearsPerPage)
            } else if (button.hasAttribute('data-archive-step')) {
              const step = Number(button.dataset.archiveStep)
              if (showingYears) yearPage += step
              else archiveYear = years[years.indexOf(archiveYear) + step]
            }
            const focusSelector = button.hasAttribute('data-archive-step') ? `[data-archive-step="${button.dataset.archiveStep}"]:not(:disabled)` : '[data-archive-years]'
            renderTimePanel()
            const focusTarget = timePanel.querySelector(focusSelector) || timePanel.querySelector('[data-archive-years]')
            focusTarget.focus({ preventScroll: true })
          })
          tagPanel.addEventListener('click', event => {
            const button = event.target.closest('[data-filter-tag]')
            if (!button) return
            selectedTag = button.dataset.filterTag
            closeFilter(true)
            applyFilters()
          })
          const dismissFilterOutside = event => {
            if (openFilter && !event.composedPath().includes(filterRoot)) closeFilter()
          }
          document.addEventListener('click', dismissFilterOutside)
          filterRoot.addEventListener('keydown', event => {
            if (event.key === 'Escape' && openFilter) {
              event.preventDefault()
              closeFilter(true)
            }
          })
          filterRoot.addEventListener('focusout', event => {
            // 切换网格会移除当前按钮，此时浏览器没有新的焦点目标。
            if (openFilter && event.relatedTarget && !filterRoot.contains(event.relatedTarget)) closeFilter()
          })
          resetFiltersButton.addEventListener('click', () => {
            clearFilters()
            timeTrigger.focus({ preventScroll: true })
          })

          const extractShuoshuoPhotos = (item, html) => {
            const photos = []
            const seen = new Set()
            const push = src => {
              const url = String(src || '').trim()
              if (!url || seen.has(url) || photos.length >= maxPhotos) return
              seen.add(url)
              photos.push(url)
            }

            if (Array.isArray(item.images)) {
              item.images.forEach(image => {
                if (typeof image === 'string') push(image)
                else if (image && typeof image === 'object') push(image.src || image.url)
              })
            }

            const parser = new DOMParser()
            const doc = parser.parseFromString(`<div id="shuoshuo-parse">${html || ''}</div>`, 'text/html')
            const root = doc.getElementById('shuoshuo-parse')
            root.querySelectorAll('img').forEach(img => {
              push(img.getAttribute('src') || img.getAttribute('data-src') || img.getAttribute('data-lazy-src'))
              let parent = img.parentElement
              img.remove()
              if (parent && parent !== root && parent.tagName === 'A' && !parent.textContent.trim() && parent.children.length === 0) {
                const anchor = parent
                parent = anchor.parentElement
                anchor.remove()
              }
              if (parent && parent !== root && parent.tagName === 'P' && !parent.textContent.trim() && parent.children.length === 0) {
                parent.remove()
              }
            })

            return { html: root.innerHTML.trim(), photos }
          }

          const thumbnailUrl = (src, width) => {
            try {
              const url = new URL(src, location.origin)
              if (url.protocol !== 'http:' && url.protocol !== 'https:') return src
              if (!url.searchParams.has('width')) url.searchParams.set('width', String(width))
              return url.toString()
            } catch {
              return src
            }
          }

          const renderPhotos = photos => {
            if (!photos.length) return ''
            const thumbWidth = photos.length === 1 ? 640 : 300
            const cells = photos.map(src => `
              <button type="button" class="moments-photo-item" data-src="${escapeHtml(src)}">
                <img class="no-lightbox" src="${escapeHtml(thumbnailUrl(src, thumbWidth))}" alt="" loading="lazy">
              </button>`).join('')
            return `<div class="moments-photos count-${photos.length}">${cells}</div>`
          }

          const classifySinglePhoto = item => {
            const image = item.querySelector('img')
            if (!image) return
            const apply = () => {
              const ratio = image.naturalWidth / image.naturalHeight
              if (!Number.isFinite(ratio) || ratio <= 0) return
              item.classList.remove('is-landscape', 'is-portrait', 'is-normal')
              item.classList.add(ratio > 1.4 ? 'is-landscape' : ratio < 0.8 ? 'is-portrait' : 'is-normal')
            }
            if (image.complete && image.naturalWidth) apply()
            else image.addEventListener('load', apply, { once: true })
          }

          const previewRoot = document.createElement('div')
          previewRoot.className = 'moments-preview'
          previewRoot.hidden = true
          previewRoot.innerHTML = `
            <button type="button" class="moments-preview-close" aria-label="关闭预览"><i class="fa-solid fa-xmark"></i></button>
            <button type="button" class="moments-preview-prev" aria-label="上一张"><i class="fa-solid fa-chevron-left"></i></button>
            <div class="moments-preview-loading" role="status" aria-label="图片加载中"></div>
            <img class="no-lightbox moments-preview-image" alt="">
            <button type="button" class="moments-preview-next" aria-label="下一张"><i class="fa-solid fa-chevron-right"></i></button>
            <div class="moments-preview-count"></div>
          `
          document.body.appendChild(previewRoot)

          const previewImage = previewRoot.querySelector('.moments-preview-image')
          const previewCount = previewRoot.querySelector('.moments-preview-count')
          let previewUrls = []
          let previewIndex = 0
          let previewToken = 0

          const showPreviewImage = () => {
            const nextSrc = previewUrls[previewIndex] || ''
            const token = ++previewToken
            const multiple = previewUrls.length > 1
            previewRoot.classList.toggle('is-single', !multiple)
            previewCount.textContent = multiple ? `${previewIndex + 1} / ${previewUrls.length}` : ''

            const cached = previewImage.getAttribute('src') === nextSrc && previewImage.complete && previewImage.naturalWidth > 0
            if (cached) {
              previewRoot.classList.remove('is-loading')
              return
            }

            previewRoot.classList.add('is-loading')
            previewImage.onload = () => {
              if (token !== previewToken) return
              previewRoot.classList.remove('is-loading')
            }
            previewImage.onerror = () => {
              if (token !== previewToken) return
              previewRoot.classList.remove('is-loading')
            }
            previewImage.src = nextSrc
          }

          const openPreview = (urls, index) => {
            previewUrls = urls
            previewIndex = index
            showPreviewImage()
            previewRoot.hidden = false
            document.body.classList.add('moments-preview-open')
          }

          const closePreview = () => {
            previewToken += 1
            previewRoot.hidden = true
            previewRoot.classList.remove('is-loading')
            previewImage.onload = null
            previewImage.onerror = null
            previewImage.src = ''
            previewUrls = []
            document.body.classList.remove('moments-preview-open')
          }

          const stepPreview = delta => {
            if (previewUrls.length < 2) return
            previewIndex = (previewIndex + delta + previewUrls.length) % previewUrls.length
            showPreviewImage()
          }

          previewRoot.addEventListener('click', event => {
            if (swipeMoved) {
              swipeMoved = false
              return
            }
            if (event.target.closest('.moments-preview-close')) {
              closePreview()
              return
            }
            if (event.target.closest('.moments-preview-prev')) {
              stepPreview(-1)
              return
            }
            if (event.target.closest('.moments-preview-next')) {
              stepPreview(1)
              return
            }
            if (event.target === previewRoot) closePreview()
          })

          document.addEventListener('keydown', event => {
            if (previewRoot.hidden) return
            if (event.key === 'Escape') closePreview()
            else if (event.key === 'ArrowLeft') stepPreview(-1)
            else if (event.key === 'ArrowRight') stepPreview(1)
          })

          let swipeStartX = 0
          let swipeStartY = 0
          let swipeTracking = false
          let swipeMoved = false

          previewRoot.addEventListener('touchstart', event => {
            if (previewRoot.hidden || previewUrls.length < 2) return
            const touch = event.changedTouches[0]
            swipeStartX = touch.clientX
            swipeStartY = touch.clientY
            swipeTracking = true
            swipeMoved = false
          }, { passive: true })

          previewRoot.addEventListener('touchend', event => {
            if (!swipeTracking) return
            swipeTracking = false
            const touch = event.changedTouches[0]
            const deltaX = touch.clientX - swipeStartX
            const deltaY = touch.clientY - swipeStartY
            if (Math.abs(deltaX) < 48 || Math.abs(deltaX) < Math.abs(deltaY)) return
            swipeMoved = true
            stepPreview(deltaX < 0 ? 1 : -1)
          }, { passive: true })

          previewRoot.addEventListener('touchcancel', () => {
            swipeTracking = false
          }, { passive: true })

          const collapseLimit = text => {
            const style = getComputedStyle(text)
            const line = parseFloat(style.lineHeight)
            const fontSize = parseFloat(style.fontSize) || 16
            return (Number.isFinite(line) ? line : fontSize * 1.65) * 6
          }

          const prepareFolds = () => {
            document.querySelectorAll('.moments-text').forEach(text => {
              const limit = collapseLimit(text)
              if (text.scrollHeight <= limit + 2) return
              text.classList.add('is-collapsed')
              text.style.maxHeight = `${limit}px`
              requestAnimationFrame(() => text.classList.add('can-fold'))
              const button = document.createElement('button')
              button.type = 'button'
              button.className = 'moments-fold'
              button.innerHTML = '<span class="moments-fold-label">展开全文</span><svg class="moments-line-icon moments-fold-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>'
              text.insertAdjacentElement('afterend', button)
            })
          }

          document.getElementById('article-container').addEventListener('click', event => {
            if (event.target.closest('[data-action="clear-shuoshuo-filters"]')) {
              clearFilters()
              timeTrigger.focus({ preventScroll: true })
              return
            }
            const tagButton = event.target.closest('.moments-tag')
            if (tagButton) {
              selectedTag = tagButton.dataset.tag
              closeFilter()
              applyFilters()
              tagTrigger.focus({ preventScroll: true })
              btf.scrollToDest(btf.getEleTop(filterRoot), 300)
              return
            }

            const foldButton = event.target.closest('.moments-fold')
            if (foldButton) {
              const text = foldButton.previousElementSibling
              if (!text || !text.classList.contains('moments-text')) return
              const collapsed = text.classList.contains('is-collapsed')
              const label = foldButton.querySelector('.moments-fold-label')
              if (collapsed) {
                text.classList.remove('is-collapsed')
                text.style.maxHeight = `${text.scrollHeight}px`
                foldButton.classList.add('is-open')
                if (label) label.textContent = '收起'
              } else {
                const limit = collapseLimit(text)
                text.classList.add('is-collapsed')
                text.style.maxHeight = `${limit}px`
                foldButton.classList.remove('is-open')
                if (label) label.textContent = '展开全文'
              }
              return
            }

            const button = event.target.closest('.moments-photo-item')
            if (!button) return
            const group = [...button.parentElement.querySelectorAll('.moments-photo-item')]
            const urls = group.map(item => item.dataset.src).filter(Boolean)
            const index = Math.max(0, group.indexOf(button))
            if (!urls.length) return
            openPreview(urls, index)
          })

          const renderData = (dataSlice) => {
            const content = dataSlice.map((item, index) => {
              const formattedDate = formatToTimeZone(item.date)
              const tags = item.tags.map(tag => `<button type="button" class="moments-tag" data-tag="${escapeHtml(tag)}" aria-label="筛选标签 ${escapeHtml(tag)}" aria-pressed="${tag === selectedTag}">#${escapeHtml(tag)}</button>`).join('')
              const lineIcon = (paths) => `<svg class="moments-line-icon" viewBox="0 0 24 24" aria-hidden="true">${paths}</svg>`
              const commentButton = item.key && !{commentsJsLoad || false}
                ? `<button type="button" class="moments-action-btn moments-action-comment" onclick="addCommentToShuoshuo(event)" aria-label="评论" aria-expanded="false">${lineIcon('<path d="M6 16.5 4 20l4.2-1.6A8 8 0 1 0 6 16.5z"/>')}</button>`
                : ''
              const commentThread = item.key
                ? `<div class="moments-thread"><div class="moments-interactive-box"><div class="moments-comment-list" hidden></div></div><div class="moments-comment-box no-comment" data-key="${escapeHtml(item.key)}"></div></div>`
                : ''
              const parsed = extractShuoshuoPhotos(item, item.content || '')
              const contentHtml = parsed.html ? `<div class="moments-text">${parsed.html}</div>` : ''
              const photosHtml = renderPhotos(parsed.photos)
              const authorName = item.author ? escapeHtml(item.author) : !{JSON.stringify(config.author || '楠瓜')}
              const avatarImg = item.avatar ? escapeHtml(item.avatar) : !{JSON.stringify(url_for(theme.avatar.img))}
              const pinHtml = item.top === true ? '<span class="moments-pin">置顶</span>' : ''
              const locationHtml = item.location
                ? `<span class="moments-tail">${lineIcon('<path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.2"/>')} ${escapeHtml(item.location)}</span>`
                : ''
              const deviceHtml = item.device
                ? `<span class="moments-tail moments-device">${lineIcon('<rect x="8" y="3" width="8" height="18" rx="2"/><path d="M11 18h2"/>')} 来自 ${escapeHtml(item.device)}</span>`
                : ''

              return `
                <div class="moments-item${item.top === true ? ' is-pinned' : ''}" data-key="${escapeHtml(item.key || '')}">
                  <div class="moments-item-avatar">
                    <img class="no-lightbox" src="${avatarImg}" alt="${authorName}">
                  </div>
                  <div class="moments-item-main">
                    <div class="moments-item-author">${authorName}</div>
                    ${contentHtml}
                    ${photosHtml}
                    ${tags ? `<div class="moments-tags">${tags}</div>` : ''}
                    <div class="moments-item-footer">
                      <div class="moments-meta-info">
                        <time class="moments-date" title="${formattedDate}">${btf.diffDate(formattedDate, true)}</time>
                        ${pinHtml}
                        ${locationHtml}
                        ${deviceHtml}
                      </div>
                      <div class="moments-actions">
                        ${commentButton}
                      </div>
                    </div>
                    ${commentThread}
                  </div>
                </div>`
            }).join('')

            const container = document.getElementById('article-container')
            container.innerHTML = `<div class="moments-list">${content}</div>`

            prepareFolds()
            container.querySelectorAll('.moments-photos.count-1 .moments-photo-item').forEach(classifySinglePhoto)
            document.dispatchEvent(new Event('shuoshuo:rendered'))
          }

          const changePage = page => {
            if (page === currentPage) return
            currentPage = page
            renderPage(currentPage)
            const container = document.getElementById('article-container')
            btf.scrollToDest(btf.getEleTop(container), 300)
          }

          const setupNavEvents = nav => {
            nav.querySelector('.shuoshuo-prev-btn').addEventListener('click', () => changePage(currentPage - 1))
            nav.querySelector('.shuoshuo-next-btn').addEventListener('click', () => changePage(currentPage + 1))
            nav.querySelector('.shuoshuo-page-numbers').addEventListener('click', event => {
              const button = event.target.closest('.shuoshuo-page-btn')
              if (button) changePage(Number(button.dataset.page))
            })
            nav.querySelector('.shuoshuo-page-jump').addEventListener('submit', event => {
              event.preventDefault()
              changePage(nav.querySelector('.shuoshuo-page-input').valueAsNumber)
            })
          }

          const renderNavigation = () => {
            const container = document.getElementById('article-container')
            let nav = container.nextElementSibling
            if (totalPages <= 1) {
              if (nav && nav.classList.contains('shuoshuo-navigation')) nav.remove()
              return
            }

            if (!nav || !nav.classList.contains('shuoshuo-navigation')) {
              nav = document.createElement('nav')
              nav.className = 'shuoshuo-navigation'
              nav.setAttribute('aria-label', '说说分页')
              nav.innerHTML = `
                <div class="shuoshuo-page-track">
                  <button type="button" class="shuoshuo-prev-btn" aria-label="上一页"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 7-5 5 5 5"/></svg></button>
                  <div class="shuoshuo-page-numbers"></div>
                  <button type="button" class="shuoshuo-next-btn" aria-label="下一页"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 7 5 5-5 5"/></svg></button>
                </div>
                <form class="shuoshuo-page-jump" aria-label="跳转页码">
                  <span class="shuoshuo-page-info"></span>
                  <span class="shuoshuo-jump-divider" aria-hidden="true"></span>
                  <label class="shuoshuo-jump-label"><span>前往</span><input type="number" class="shuoshuo-page-input" min="1" step="1" required inputmode="numeric" aria-label="输入页码"></label>
                  <button type="submit" class="shuoshuo-jump-btn" aria-label="跳转到指定页码" title="跳转，也可以按回车"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 6v6a3 3 0 0 1-3 3H5m4-4-4 4 4 4"/></svg></button>
                </form>
              `
              container.insertAdjacentElement('afterend', nav)
              setupNavEvents(nav)
            }

            const pages = []
            if (totalPages <= 7) {
              for (let page = 1; page <= totalPages; page++) pages.push(page)
            } else {
              pages.push(1)
              const start = currentPage <= 4 ? 2 : currentPage >= totalPages - 3 ? totalPages - 4 : currentPage - 1
              const end = currentPage <= 4 ? 5 : currentPage >= totalPages - 3 ? totalPages - 1 : currentPage + 1
              if (start > 2) pages.push(null)
              for (let page = start; page <= end; page++) pages.push(page)
              if (end < totalPages - 1) pages.push(null)
              pages.push(totalPages)
            }
            const focusedPage = nav.querySelector('.shuoshuo-page-btn:focus')?.dataset.page
            nav.querySelector('.shuoshuo-page-numbers').innerHTML = pages.map(page => page === null
              ? '<span class="shuoshuo-page-ellipsis" aria-hidden="true">…</span>'
              : `<button type="button" class="shuoshuo-page-btn" data-page="${page}" aria-label="第 ${page} 页"${page === currentPage ? ' aria-current="page"' : ''}>${page}</button>`
            ).join('')
            if (focusedPage) nav.querySelector(`[data-page="${currentPage}"]`).focus({ preventScroll: true })
            nav.querySelector('.shuoshuo-prev-btn').disabled = currentPage === 1
            nav.querySelector('.shuoshuo-next-btn').disabled = currentPage === totalPages
            nav.querySelector('.shuoshuo-page-info').textContent = `共 ${totalPages} 页`
            nav.querySelector('.shuoshuo-page-jump').hidden = totalPages <= 7
            const input = nav.querySelector('.shuoshuo-page-input')
            input.disabled = totalPages <= 7
            input.max = totalPages
            input.value = currentPage
            input.title = `请输入 1 至 ${totalPages} 的页码`
          }

          const renderPage = (page) => {
            const start = (page - 1) * itemsPerPage
            const end = start + itemsPerPage
            const pageData = data.slice(start, end)
            if (data.length) {
              renderData(pageData)
            } else {
              const container = document.getElementById('article-container')
              container.innerHTML = allData.length
                ? '<div class="moments-empty" role="status"><i class="fa-regular fa-comment-dots"></i><p>这个筛选下还没有说说</p><button type="button" class="moments-empty-reset" data-action="clear-shuoshuo-filters">查看全部动态</button></div>'
                : '<div class="moments-empty"><i class="fa-regular fa-comment-dots"></i><p>还没有发布任何说说~</p></div>'
            }
            renderNavigation()
          }

          const loadShuoshuo = async () => {
            const container = document.getElementById('article-container')
            try {
              let originData = []
              if (!{Boolean(page.shuoshuo_url)}) {
                container.innerHTML = '<div class="moments-loading"><i class="fa-solid fa-circle-notch fa-spin"></i><span>正在加载动态...</span></div>'
                const response = await fetch('!{url_for(page.shuoshuo_url)}')
                if (!response.ok) throw new Error(`HTTP ${response.status}`)
                originData = await response.json()
              } else {
                const dataElement = document.getElementById('shuoshuo-data')
                originData = dataElement ? JSON.parse(dataElement.textContent) : []
              }

              allData = filterDataByLimit(sortDataByDate(originData), limitConfig).map(item => ({
                ...item,
                month: formatToTimeZone(item.date).slice(0, 7),
                tags: item.tags || []
              }))
              setupFilters()
              applyFilters()
            } catch (error) {
              console.error(error)
              container.innerHTML = '<div class="moments-error"><i class="fa-solid fa-circle-exclamation"></i><p>加载说说失败，请稍后刷新重试</p></div>'
            }
          }

          const pjaxCleanup = () => {
            document.removeEventListener('click', dismissFilterOutside)
            closePreview()
            previewRoot.remove()
            const container = document.getElementById('article-container')
            if (container) {
              const nav = container.nextElementSibling
              if (nav && nav.classList.contains('shuoshuo-navigation')) nav.remove()
            }
            document.removeEventListener('pjax:send', pjaxCleanup)
          }

          if (window.pjax) {
            document.addEventListener('pjax:send', pjaxCleanup)
            loadShuoshuo()
          } else {
            window.addEventListener('load', loadShuoshuo)
          }
        })()
